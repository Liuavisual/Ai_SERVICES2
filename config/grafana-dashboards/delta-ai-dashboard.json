      "panels": [],
      "title": "Delta AI 客服系统 - 应用性能总览",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
          "expr": "process_cpu_usage{application=\"delta-ai-customer-service\"} * 100",
          "refId": "A"
        }
      ],
      "title": "CPU 使用率",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
          "expr": "jvm_memory_used_bytes{application=\"delta-ai-customer-service\", area=\"heap\"}",
          "refId": "A"
        }
      ],
      "title": "JVM 堆内存",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-delta" },
          "expr": "rate(http_server_requests_seconds_count{application=\"delta-ai-customer-service\"}[5m])",
          "legendFormat": "{{uri}} - {{method}}",
          "refId": "A"
        }
      ],
      "title": "HTTP 请求速率 (5m 平均)",
      "type": "timeseries"
    },
    {
